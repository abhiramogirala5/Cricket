# --- secrets / local env (never commit) ---
.env
.env.*
!.env.example
!**/.env.example

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# --- Python (backend) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
backend/*.db
backend/*.sqlite3

# --- Flutter / Dart (frontend) ---
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/coverage/
frontend/pubspec.lock.bak

# Android boilerplate (auto-generated by Flutter)
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/key.properties
frontend/android/app/*.jks
frontend/android/app/*.keystore
frontend/android/app/debug/
frontend/android/app/profile/
frontend/android/app/release/
frontend/android/.kotlin/
frontend/android/captures/

# iOS boilerplate (auto-generated by Flutter)
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/ios/Flutter/ephemeral/
frontend/ios/**/xcuserdata/
frontend/ios/Runner/Assets.xcassets/AppIcon.appiconset/Icon-App-*.png
frontend/ios/Runner/Assets.xcassets/LaunchImage.imageset/LaunchImage*.png
frontend/ios/.generated/
frontend/ios/Flutter/Generated.xcconfig
frontend/ios/Flutter/flutter_export_environment.sh

# Generated Dart files
frontend/**/*.g.dart
frontend/**/*.freezed.dart
frontend/**/*.mocks.dart

*.iml

# --- Docker ---
docker-compose.override.yml
