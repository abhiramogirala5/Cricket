# Gully Umpire — Flutter app configuration
#
# Copy this file to `.env` (git-ignored):   cp .env.example .env
#
# IMPORTANT: this file is bundled into the app as an asset. Anything in it can be extracted
# from the installed app, so it must contain NON-SECRET values only.
# Real secrets (JWT secret, database password, Sentry DSN, ...) live in backend/.env.

# development | staging | production
APP_ENV=development

# Base URL of the backend WITHOUT the /api/v1 suffix.
#   Android emulator -> host machine:  http://10.0.2.2:8000
#   iOS simulator / desktop:           http://localhost:8000
#   Physical device on the same Wi-Fi: http://<your-computer-LAN-ip>:8000
#   Production:                        https://api.example.com   (https is required)
# Leave EMPTY to run in local-only mode (no account, no sync; non-production builds only).
API_BASE_URL=http://10.0.2.2:8000

# The umpire assistant on the phone's live camera (Android): it follows the ball in the camera
# picture and suggests wide / no-ball from the ball height compared with the batter. Set to false
# to use the app as a plain scorer. (Other platforms always run as a plain scorer for now.)
ENABLE_LIVE_CV=true

# Development only: play back SIMULATED detections instead of using the camera (shows a
# "Simulated" badge everywhere). Keep this false. A production build refuses to start with it on.
# (This key replaces the old ENABLE_MOCK_CV, which is now ignored.)
DEV_SIMULATE_CV=false

# Review assistance from the tracked ball path (it only gives evidence for the umpire and never
# dismisses a batter by itself). A match must also switch the rule on when it is created.
#   ENABLE_EDGE_REVIEW: did the ball change direction near the bat?
#   ENABLE_LBW_REVIEW:  where did the ball pitch, hit the pad and was it going on to the stumps?
#                       (also turns on the "ball hitting the wicket" check)
ENABLE_EDGE_REVIEW=true
ENABLE_LBW_REVIEW=true

# Network timeout in seconds (3-120).
HTTP_TIMEOUT_SECONDS=20
