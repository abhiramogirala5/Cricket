# Copy to `.env` and fill in real values. `.env` is git-ignored; this file is committed.
# This file is the ONLY configuration surface of the backend (see app/core/config.py).

# development | staging | production | test
# production enables strict start-up checks (strong JWT secret, PostgreSQL, no wildcard CORS)
# and disables /docs, /redoc and /openapi.json.
APP_ENV=development

# SQLAlchemy URL. PostgreSQL is required in production.
# postgres:// and postgresql:// are accepted and rewritten to postgresql+asyncpg://
#
# Local PostgreSQL:
#   postgresql+asyncpg://gully:change_me@localhost:5432/gully_umpire
#
# Supabase (Project -> Connect). Use the "Direct connection" string, or the "Session pooler" string
# if your network has no IPv6. BOTH listen on port 5432. Do NOT use the "Transaction pooler"
# (port 6543): the API refuses to start with it. TLS is switched on automatically for *.supabase.co
# and *.supabase.com hosts. If the database password contains @ : / ? # or %, URL-encode it
# (for example @ becomes %40).
#   postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://gully:change_me@localhost:5432/gully_umpire
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=30

# REQUIRED. Signs access tokens (HS256). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Production refuses to start if this is shorter than 32 characters or is the placeholder below.
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# A just-rotated refresh token that is presented again within this window is rejected
# without revoking the whole token family (covers a client retrying after a dropped response).
REFRESH_REUSE_GRACE_SECONDS=10

# Comma-separated browser origins allowed by CORS. Native mobile apps do not need CORS.
# A "*" wildcard is rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Per-client-IP sliding window on /api/v1/auth/*
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# Set to true ONLY behind a reverse proxy you control: the client IP is then taken from X-Forwarded-For.
TRUSTED_PROXY=false

# Request bodies larger than this are rejected with 413 (default 2 MiB).
MAX_REQUEST_BODY_BYTES=2097152

# ---- Supabase Storage: replay files of deliveries (optional) -------------------------------------
# The replay of a delivery (ball path, batter pose, frames) is a small file that the phone uploads to
# a PRIVATE Supabase Storage bucket through short-lived signed links made by this API. The phone
# never sees a Supabase key. Leave both empty to run without replay storage (replay endpoints then
# answer 503; the rest of the API is unaffected). Set both or neither.
#
# SUPABASE_URL: Project settings -> API -> Project URL, for example https://abcdefgh.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: Project settings -> API keys -> the secret / service_role key.
#   It bypasses all access rules: keep it ONLY in this file on the server, never in the Flutter app.
SUPABASE_URL=https://awjknqsbfkmulcxfqvdx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImF3amtucXNiZmttdWxjeGZxdmR4Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MzM2NDYzOSwiZXhwIjoyMTA4OTQwNjM5fQ.BTeQbD1UnztZH7Zh82a_mGGDK8oq1SqA5X6TIblDz1Y
# Created automatically (private) when the API starts, if it does not exist yet.
SUPABASE_REPLAY_BUCKET=replays
# Largest replay file accepted (bytes, 1 KiB - 50 MiB). A replay of one delivery is normally 0.3-4 MiB.
REPLAY_MAX_BYTES=8388608
# How long a download link stays valid (seconds, 60-3600).
REPLAY_DOWNLOAD_TTL_SECONDS=600

LOG_LEVEL=INFO

# Optional error reporting. Leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
